<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <!-- Everything in wwwroot is served from /App_Plugins/SA.Umbraco.MediaPreview/ -->
    <StaticWebAssetBasePath>App_Plugins/SA.Umbraco.MediaPreview</StaticWebAssetBasePath>
    <DefaultItemExcludes>$(DefaultItemExcludes);Client/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SA.Umbraco.MediaPreview</PackageId>
    <Version>1.0.0</Version>
    <Title>SA.Umbraco.MediaPreview</Title>
    <Description>Adds a Preview action to Umbraco media cards that opens the media item in a fly-out, so you can view images and play video or audio without leaving the media section, plus a Copy URL action for files.</Description>
    <Authors>suedeapple</Authors>
    <Company>suedeapple</Company>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;media;preview;video;audio</PackageTags>
    <PackageProjectUrl>https://github.com/suedeapple/SA.Umbraco.MediaPreview</PackageProjectUrl>
    <RepositoryUrl>https://github.com/suedeapple/SA.Umbraco.MediaPreview</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>saUmbracoMediaPreview.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco 17.3 (when media cards gained hover actions) up to 18. Raise the upper bound once a new major has been tested. -->
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.3.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../saUmbracoMediaPreview.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    Builds the backoffice client into wwwroot. Needs Node.js 20.19+ or 22.12+.
    Pass -p:SkipClientBuild=true to use an existing wwwroot (e.g. built in an earlier CI step).
  -->
  <Target Name="SAMediaPreviewRestoreClient" Condition="'$(SkipClientBuild)' != 'true'" Inputs="Client/package.json;Client/package-lock.json" Outputs="Client/node_modules/.package-lock.json">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="Client" />
  </Target>

  <Target Name="SAMediaPreviewBuildClient" BeforeTargets="BeforeBuild" DependsOnTargets="SAMediaPreviewRestoreClient" Condition="'$(SkipClientBuild)' != 'true'">
    <!-- The client build writes this version into umbraco-package.json, so the .csproj (or a release tag) is the only place it's set. -->
    <Exec Command="npm run build" WorkingDirectory="Client" EnvironmentVariables="SA_PACKAGE_VERSION=$(Version)" />
    <!-- wwwroot didn't exist when items were evaluated on a clean build, so add the fresh output now. -->
    <ItemGroup>
      <Content Include="wwwroot/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
